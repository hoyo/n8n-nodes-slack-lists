{
	"name": "n8n-nodes-slack-lists",
	"version": "1.0.0",
	"description": "n8n community node for Slack Lists (slackLists.* API)",
	"license": "MIT",
	"homepage": "https://github.com/hoyo/n8n-nodes-slack-lists",
	"keywords": [
		"n8n-community-node-package",
		"slack",
		"slack-lists"
	],
	"author": {
		"name": "Keigo Aoki",
		"email": "hoyo1111@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/hoyo/n8n-nodes-slack-lists.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [],
		"nodes": [
			"dist/nodes/SlackLists/SlackLists.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.43.1",
		"eslint": "9.39.5",
		"n8n-workflow": "2.16.0",
		"prettier": "3.9.6",
		"release-it": "21.0.1",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
